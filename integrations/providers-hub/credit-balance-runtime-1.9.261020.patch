@@ -0,0 +1,52 @@
+/**
+ * 跨插件只读余额投影。读取复用宿主已有的余额编排，不接收凭据、账号池或 fetch。
+ * 只允许白名单数值和展示字段跨越服务边界，登录标识与原始错误留在宿主内。
+ */
+export interface CreditBalanceService {
+    supportedProviders(): Array<{
+        id: string;
+        displayName: string;
+    }>;
+    creditsBalances(providerId: string): Promise<{
+        accounts: PublicCreditAccount[];
+    }>;
+}
+export interface PublicCreditPackage {
+    name: string;
+    unit: string;
+    remaining?: number;
+    total?: number;
+    used?: number;
+    active?: boolean;
+    expiredTime?: string;
+    deductionEndTime?: number;
+}
+export interface PublicCreditAccount {
+    /** 仅在本次响应内区分账号，不暴露登录标识，也不保证跨响应稳定。 */
+    accountId: string;
+    nickname: string;
+    balance: {
+        total: number;
+        packages: PublicCreditPackage[];
+        unit?: string;
+    } | null;
+    stale?: boolean;
+    error?: 'unknown' | 'upstream-invalid-response' | 'stale-balance';
+}
+declare module '@deepseek-ai/cordis' {
+    interface Context {
+        creditBalance: CreditBalanceService;
+    }
+}
+interface ProviderDescriptor {
+    readonly id: string;
+    readonly label: string;
+    readonly credits: {
+        readonly balance: boolean;
+    };
+}
+export declare function createCreditBalanceService(deps: {
+    providers: () => readonly ProviderDescriptor[];
+    read: (providerId: string) => Promise<unknown>;
+}): CreditBalanceService;
+export {};
